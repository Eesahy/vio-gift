# Copy to .env and fill in. Everything here is bundled into the website and is public by design.
# Never put the Paystack SECRET key (sk_...) in this file — it lives in Firebase Secret Manager:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
# For the local emulator, put it in functions/.secret.local instead.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Not required by checkout (the server opens each Paystack transaction), kept for reference.
VITE_PAYSTACK_PUBLIC_KEY=

# Optional: point the app at local Firebase emulators.
# VITE_USE_EMULATORS=true
